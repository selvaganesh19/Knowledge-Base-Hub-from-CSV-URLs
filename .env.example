# Copy to .env and fill in. Everything here has a working default except the API keys.

# Which LLM to use for answer synthesis and person extraction.
# auto = try groq, then gemini, then fall back to retrieval-only (no LLM).
LLM_PROVIDER=auto

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Tried in order if the primary model is retired by Groq.
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

EMBEDDING_MODEL=all-MiniLM-L6-v2

# Concurrent URL fetches during a harvest job.
SCRAPE_WORKERS=6

# Which crawler to use.
#   http     = the built-in httpx + trafilatura pipeline (default)
#   crawl4ai = the optional Crawl4AI engine (pip install crawl4ai)
#
# Safe to enable. If Crawl4AI is missing, or errors on startup, or a URL defeats it,
# that URL falls back to the built-in engine and the harvest completes as normal.
# Crawl4AI records which strategy it used in each row's scraping_method:
#   crawl4ai:browser  - full JavaScript rendering (needs Chromium, see below)
#   crawl4ai:http     - its own HTTP fetcher, which gets through some sites that
#                       block a plain client
CRAWL_ENGINE=http

# Honour robots.txt. Disallowed URLs are still stored, with an error explaining why.
RESPECT_ROBOTS=1

# How long one request may take, and how many extra attempts a transient failure
# gets. Only 408/425/429/500/502/503/504, timeouts and connection resets are
# retried - never 401/403/404, which will fail identically next time.
REQUEST_TIMEOUT=20
MAX_RETRIES=2

# Minimum gap in seconds between two requests to the same host. Six workers hitting
# six different sites is fine; six hitting one site is a burst that invites a 429.
CRAWL_DELAY=1.0

# Content quality floor. A page that returns 200 but yields less than this is
# recorded as PARTIAL rather than SUCCESS, because a page of navigation produces
# chunks that match queries and answer nothing.
MIN_TEXT_LENGTH=500
MIN_WORD_COUNT=100

# JavaScript rendering. Many sites build their content in the browser, so the HTTP
# fetcher sees an empty shell. Playwright runs a real browser for those pages.
# It needs the Chromium binary: python -m playwright install chromium
# The app runs fine without it and reports which pages needed it.
ENABLE_PLAYWRIGHT=1
PLAYWRIGHT_TIMEOUT=30000

# Follow priority internal links from each crawled page (/leadership, /team, /about)
# in addition to the URLs in the CSV. Off by default: the assignment supplies an
# explicit URL list and expects one row per URL.
DISCOVER_LINKED_PAGES=0
MAX_PAGES_PER_URL=25
MAX_CRAWL_DEPTH=2
SAME_DOMAIN_ONLY=1

# Upload guards.
MAX_UPLOAD_BYTES=10000000
MAX_URLS_PER_UPLOAD=500

# SSRF guard. Loopback, private ranges and cloud metadata endpoints are refused by
# default so an uploaded CSV cannot make the server probe its own network.
# Set to 1 only for local development - the demo documents are served from
# 127.0.0.1, which this blocks.
ALLOW_PRIVATE_HOSTS=0

# Cosine similarity cutoff for search results. Below this, a hit is dropped.
SEARCH_MIN_SCORE=0.25

# How many chunks retrieval returns and the LLM is shown.
TOP_K=8

# A page must score at least this fraction of the best-matching page's score
# before the people extracted from it are shown as answers. Without it, a question
# about one company surfaces another company's executives, because any page that
# cleared the floor above contributed its whole leadership team. Lower it to see
# more cards, raise it to see only the closest match's people.
PERSON_RELEVANCE_RATIO=0.75

# Chain the indexing (and person extraction) job automatically after a harvest.
AUTO_INDEX=1
AUTO_EXTRACT=1

# Largest response body read from a harvested URL, in bytes.
MAX_HTML_BYTES=5000000

# Documents (PDF, DOCX, text) are binary and often much larger than a page of
# markup, so they get their own cap. Set PARSE_DOCUMENTS=0 to skip them entirely.
PARSE_DOCUMENTS=1
MAX_DOCUMENT_BYTES=25000000

# Logging: console always, plus a rotating file when LOG_TO_FILE is on.
LOG_LEVEL=INFO
LOG_TO_FILE=1
